  void set_rendezvous_enabled(boolean enabled);
  void set_internet_enabled(boolean enabled);
  boolean is_internet_enabled();
  void set_crowd_mode(boolean enabled);
  boolean is_crowd_mode_enabled();
  void set_privacy_shaping(PrivacyShapingConfig config);
  PrivacyShapingOverheadEstimate privacy_shaping_overhead_estimate(PrivacyShapingConfig config);
  PrivacyShapingConfig default_privacy_shaping_config(PrivacyShapingProfile profile);
  sequence<string> get_shareable_multiaddrs();
  [Throws=MycenaException]
  bytes build_offline_share_bootstrap_sidecar(string install_url);
  u32 propagate_installed_miniapps();
  void add_bootstrap_peer(string multiaddr);
  [Throws=MycenaException]
  void connect_invite(string raw);
  [Throws=MycenaException]
  void connect_transport_invite(string raw);
  void set_wifi_aware_available(boolean available);
  void set_ble_discovery_active(boolean active);
  boolean prefer_wifi_aware_for_discovery();
  void queue_discovery_announcement(string invite_uri);
  void ingest_wifi_aware_discovery(string peer_hint, string invite_uri, u64 latency_ms);
  void record_ble_discovery_observation(u64 latency_ms, u32 bytes, boolean success);
  sequence<string> drain_discovery_announcements(u32 max);
  void set_webrtc_available(boolean available);
  void set_webrtc_link_ready(string peer, boolean ready);
  [Throws=MycenaException]
  void ingest_webrtc_frame(string from_peer, bytes frame);
  void post_webrtc_signal(string to_peer, string session_id, u8 kind, string payload, u32? ice_mline_index);
  sequence<WebRtcSignalFrame> drain_webrtc_signaling_inbound(u32 max);
  sequence<string> drain_webrtc_negotiation_requests(u32 max);
  sequence<string> webrtc_stun_servers();
  [Throws=MycenaException]
  void ingest_ble_frame(string from_peer, bytes frame);
  string? peer_id_from_ble_frame(bytes frame);
  sequence<BleOutboundFrame> drain_ble_outbound(string? to_peer, u32 max);
  sequence<BleOutboundFrame> drain_bearer_outbound(string? to_peer, u32 max);
  [Throws=MycenaException]
  void queue_bearer_bulk(string to_peer, bytes payload);
  void register_ble_link(string peer_id, string device_id);
  [Throws=MycenaException]
  void ingest_ble_stream_frame(string from_peer, bytes frame);
  sequence<bytes> drain_ble_stream_outbound(string to_peer, u32 max);
  sequence<string> ble_peer_addrs();
  void set_event_callback(NodeEventCallback callback);

  string wallet_address();
  WalletBalance wallet_balance();
  sequence<VoucherRiskInfo> wallet_voucher_risks();
  void send_transaction(string to_address, u64 amount_muon, string? memo);
  sequence<TxInfo> wallet_recent_transactions(u32 limit);
  void request_faucet();

  sequence<MiniAppInfo> list_installed_apps();
  [Throws=MycenaException]
  MiniAppInstallPreview preview_miniapp_install(bytes bundle_data);
  [Throws=MycenaException]
  MiniAppInfo install_app(bytes bundle_data, string? listing_app_id, boolean allow_sideload, boolean allow_downgrade);
  [Throws=MycenaException]
  MiniAppInfo install_official_bundle(string app_id);
  [Throws=MycenaException]
  void uninstall_app(string app_id);
  bytes? get_app_file(string app_id, string path);
  sequence<AppStoreListing> browse_app_store();
  string? miniapp_storage_get(string app_id, string key);
  [Throws=MycenaException]
  void miniapp_storage_set(string app_id, string key, string value);
  [Throws=MycenaException]
  void miniapp_storage_delete(string app_id, string key);
  string miniapp_bridge_call(string app_id, string method, string args_json);
  string miniapp_get_runtime(string app_id);
  i32 miniapp_invoke_wasm_run(string app_id);
  string miniapp_issue_bridge_session(string app_id);
  void miniapp_revoke_bridge_session(string app_id);
  [Throws=MycenaException]
  string miniapp_issue_capability(string app_id, string permission, string session_token);
  [Throws=MycenaException]
  void miniapp_publish_revocation(string app_id, string reason);
  [Throws=MycenaException]
  MiniAppPolicyData miniapp_get_policy(string app_id);
  [Throws=MycenaException]
  void miniapp_set_safe_mode(string app_id, boolean enabled);
  [Throws=MycenaException]
  void miniapp_report_app(string app_id);

  ConnectivityMode current_connectivity_mode();

  HotWalletConfig get_hot_wallet_config();
  void set_hot_wallet_config(HotWalletConfig config);
  void set_cold_wallet_address(string? address);
  HotWalletStatus hot_wallet_status();

  string build_payment_request_uri(string to_address, u64 amount_muon, string? memo);
  PaymentRequestData? parse_payment_request_uri(string uri);
};

dictionary WalletBalance {
  u64 confirmed_muon;
  u64 pending_muon;
  u64 settled_muon;
  u64 unsettled_voucher_muon;
  u64 voucher_reserved_muon;
};

dictionary VoucherRiskInfo {
  string voucher_id;
  u64 amount_muon;
  string risk;
  string message;
};

dictionary TxInfo {
  string id;
  string from_address;
  string to_address;
  u64 amount_muon;
  u64 fee_muon;
  u64 timestamp_ms;
  string? memo;
  u32 witness_count;
  boolean confirmed;
};

dictionary BleOutboundFrame {
  string to_peer;
  bytes frame;
  u8 medium;
};

dictionary WebRtcSignalFrame {
  string from_peer;
  string session_id;
  u8 kind;
  string payload;
  u32? ice_mline_index;
};

dictionary NodeConfig {
  string db_path;
  string listen_addr;
  string display_name;
  sequence<string> bootstrap_peers;
  /// Optional 64-char hex (32 bytes) master key for at-rest encryption (host-provided; mobile Keychain/Keystore).
  string? storage_key_hex;
  /// Opt-in relay rendezvous (find/be found on public relay).
  boolean rendezvous_enabled;
  /// When false, local mesh only — no relay/bootstrap dials (user opt-out).
  boolean internet_enabled;
  /// Bulletin scopes subscribed at startup (opt-in).
  sequence<string> bulletin_subscriptions;
  /// Dense-event tuning: cap mDNS dials, dense gossip (transport limits apply at node start).
  boolean crowd_mode;
};

dictionary NodeMetrics {
  u64 messages_forwarded;
  u64 messages_dropped_ttl;
  u64 messages_dropped_queue;
  u64 messages_delivered_local;
  u64 pending_queue_size;
  u64 seen_cache_size;
  u64 connected_peers;
  u64 max_peers;
  u64 peer_cap_rejections;
  boolean crisis_active;
  boolean crowd_density_active;
  u64 crisis_dropped_background_gossip;
  u64 crisis_dropped_background_forward;
  u64 crisis_dropped_background_sync;
  u64 webrtc_links_active;
  boolean webrtc_host_available;
  boolean wifi_aware_available;
  u64 discovery_events_wifi_aware;
  u64 discovery_events_ble;
  boolean prefer_wifi_aware_discovery;
};

enum ExpectedDeliveryBasis {
  "DeliveryProbability",
  "EncounterFrequency",
  "NoCarriersNearby",
};

dictionary ExpectedDeliveryData {
  u64 eta_min_ms;
  u64 eta_max_ms;
  f64 confidence;
  u32 active_carrier_count;
  string? best_carrier_peer;
  ExpectedDeliveryBasis basis;
};

dictionary CustodyPendingStatus {
  string message_id;
  string? dest_peer;
  string chat_body;
  string app_chat_id;
  u64 enqueued_at_ms;
  u8 sprays_released;
  u8 max_spray;
  u8 hop_count;
  ExpectedDeliveryData expected;
};

dictionary UserTrustSummary {
  u32 relay_contribution;
  u64 uptime_secs;
  u32 successful_deliveries;
  u32 local_endorsements;
  f64 contribution_score;
  string contribution_tier;
};

dictionary HotWalletConfig {
  u64 max_cache_muon;
  u64 refill_threshold_muon;
  u64 refill_amount_muon;
  string? cold_wallet_address;
};

dictionary HotWalletStatus {
  u64 confirmed_muon;
  u64 pending_muon;
  u64 max_cache_muon;
  boolean auto_refill_enabled;
  boolean needs_refill;
  ConnectivityMode connectivity;
};

dictionary PaymentRequestData {
  string to_address;
  u64 amount_muon;
  string? memo;
  u64? expires_at_ms;
};

dictionary ChatMessage {
  string id;
  string from_peer;
  string from_display_name;
  string body;
  u64 timestamp_ms;
};

dictionary BulletinPost {
  string id;
  string from_display_name;
  string title;
  string body;
  string scope;
  u64 timestamp_ms;
  u64 expires_at_ms;
};

dictionary InformationTrustData {
  u32 corroboration_count;
  u32 trusted_corroboration_count;
  f32 source_diversity;
  f32 geographic_consistency;
  f32 staleness_factor;
  f32 trust_score;
  string status;
  string display_label;
};

dictionary SosPost {
  string geohash;
  string message;
  u64 created_at_ms;
  InformationTrustData trust;
};

dictionary ResourceMapEntry {
  string geohash;
  string category;
  string description;
  u64 created_at_ms;
  u64 ttl_secs;
  u64 expires_at_ms;
  InformationTrustData trust;
};

dictionary VolunteerTaskEntry {
  string task_id;
  string geohash;
  string category;
  string description;
  u32 slots_needed;
  u32 slots_open;
  u32 claims_count;
  u64 created_at_ms;
  u64 ttl_secs;
  u64 expires_at_ms;
};

dictionary MailMessage {
  string id;
  string from_peer;
  string from_display_name;
  string to_peer;
  string subject;
  string body;
  u64 timestamp_ms;
  boolean is_read;
};

dictionary GroupInfo {
  string id;
  string name;
  u32 member_count;
  u64 created_at_ms;
};

enum ContactStatus {
  "Pending",
  "Accepted",
  "Blocked",
};

dictionary PeerReputationData {
  u8 strikes;
  u64 last_strike_ms;
  u64 throttled_until_ms;
  f32 reliability;
  f32 spam_score;
  f32 relay_success_rate;
  u64 age_ms;
  u16 mutual_contacts;
};

dictionary ContactInfo {
  string peer_id;
  string display_name;
  u64 added_at_ms;
  ContactStatus status;
  string? account_id;
};

dictionary MiniAppInfo {
  string id;
  string name;
  string description;
  string version;
  string developer;
  string entry;
  boolean accepts_payments;
  string? payment_address;
  sequence<string> permissions;
};

dictionary MiniAppInstallPreview {
  MiniAppInfo manifest;
  string bundle_hash;
  string trust_level;
  boolean listing_signature_ok;
  string? installed_version;
  boolean is_downgrade;
  boolean has_inline_script;
  boolean strict_csp_eligible;
  boolean bundle_signature_ok;
  boolean reproducible_attested;
};

dictionary AppStoreListing {
  MiniAppInfo manifest;
  string bundle_hash;
  u64 updated_at_ms;
  boolean signature_valid;
};

dictionary MiniAppPolicyData {
  string app_id;
  u8 reputation_score;
  boolean safe_mode_active;
  boolean safe_mode_forced;
  boolean safe_mode_suggested;
  boolean user_safe_mode;
  boolean revoked;
  boolean strict_csp_eligible;
};

dictionary PresenceProfileData {
  string? display_name;
  string? bio;
  u8? age;
  string? gender;
  string? looking_for;
  sequence<string> interests;
  string? photo_base64;
};

dictionary NearbyProfile {
  string ephemeral_id;
  string enc_pubkey_hex;
  string? display_name;
  string? bio;
  u8? age;
  string? gender;
  string? looking_for;
  sequence<string> interests;
  string? photo_base64;
  u64 seen_at_ms;
  boolean has_expired;
  boolean interest_sent;
  boolean interest_received;
  boolean is_mutual;
};

dictionary ProximityMessageData {
  string from_enc_pubkey_hex;
  string body;
  u64 received_at_ms;
};

dictionary ScopeKeyInfo {
  string scope;
  string display_name;
  u64 added_at_ms;
};

enum EnergyState {
  "Active",
  "Intermittent",
  "Passive",
};

enum ThermalState {
  "Normal",
  "Warm",
  "Critical",
};

enum MovementIndicator {
  "Unknown",
  "Stationary",
  "InMotion",
};

dictionary EnergyProfileData {
  EnergyState battery;
  ThermalState thermal;
  MovementIndicator movement;
};

enum PrivacyShapingProfile {
  "Fast",
  "Balanced",
  "Paranoid",
};

dictionary PrivacyShapingConfig {
  boolean enabled;
  PrivacyShapingProfile profile;
  u64 batch_min_ms;
  u64 batch_max_ms;
  boolean padding_enabled;
  boolean scope_bucketing_enabled;
  boolean cover_traffic_enabled;
  u64 cover_interval_secs;
};

dictionary PrivacyShapingOverheadEstimate {
  double padding_overhead_pct_typical;
  u64 batch_latency_ms_min;
  u64 batch_latency_ms_max;
  u64 cover_bytes_per_hour_active;
  u64 cover_bytes_per_hour_intermittent;
  string battery_impact_summary;
};

enum ConnectivityMode {
  "Internet",
  "MeshOnly",
};

callback interface NodeEventCallback {
  void on_peer_discovered(string peer_id);
  void on_peer_lost(string peer_id);
  void on_chat_received(ChatMessage message);
  void on_mail_received(MailMessage message);
  void on_bulletin_received(BulletinPost post);
  void on_sos_received(SosPost post);
  void on_app_store_listing(AppStoreListing listing);
  void on_connectivity_changed(ConnectivityMode mode);
  void on_contact_request(string peer_id, string display_name);
};

[Error]
interface MycenaException {
  InstallError(string detail);
  ChatError(string detail);
  HostError(string detail);
};
