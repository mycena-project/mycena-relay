# Mycena relay — canonical image for Fly.io and local `docker build`.
# Build context must be the repository root (Cargo workspace).

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM rust:1.88-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The whole workspace is needed (the relay depends on mycena-core + mycena-node),
# including the patched gossipsub fork under third-party/.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/
COPY third-party/ ./third-party/

# Build only the relay binary
RUN cargo build --release -p mycena-relay

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -u 1001 -s /bin/false mycena
RUN mkdir -p /data && chown mycena:mycena /data

COPY --from=builder /app/target/release/mycena-relay /usr/local/bin/mycena-relay
RUN chmod +x /usr/local/bin/mycena-relay

USER mycena

EXPOSE 4001/tcp
EXPOSE 4001/udp
EXPOSE 8080/tcp

ENV RUST_LOG=info,mycena_relay=debug

CMD ["/usr/local/bin/mycena-relay", \
     "--listen", "/ip4/0.0.0.0/tcp/4001", \
     "--listen-quic", "/ip4/0.0.0.0/udp/4001/quic-v1", \
     "--keypair-path", "/data/identity", \
     "--status-port", "8080"]
